{#
 # Page banner (hero): a fixed part of every page, filled in on the entry's Banner tab, not a
 # pageBuilder block (as in Site7 Engine). Figma: Home 6-2210 (split, dark); other layouts are
 # used by landing pages. Included by _entries/page.twig only when the page has a heading or images.
 # The heading is the page's <h1>.
 # Receives: page (the entry)
 # Fields (Banner tab): heroLayout, scheme, eyebrow, heading, rotatingWords, text, buttons (common Matrix), images,
 #         chatMessages (split layout: animated chat over images[0], see _components/hero-chat.twig)
 #}
{% set layout = page.heroLayout.value ?? 'split' %}
{% set scheme = page.scheme.value ?? 'light' %}
{% set dark = scheme == 'dark' %}
{% set media = page.images.eagerly().all() %}
{% set tag = 'h1' %}
{% set buttons = page.buttons.eagerly().all() %}
{% set hasButtons = buttons|filter(b => b.buttonLink.url ?? false)|length > 0 %}

{% set sectionClass = [
    'relative overflow-hidden',
    layout == 'fullBleed' ? 'min-h-svh' : 'pt-32 pb-16 md:pt-44 lg:pb-24',
]|join(' ') %}

{% macro buttons(buttons, dark) %}
    {% include '_components/buttons.twig' with {
        buttons: buttons,
        variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'darkOnDark' : 'light' },
        dark: dark, shape: 'rounded', class: 'flex flex-wrap gap-3',
    } only %}
{% endmacro %}

{# No spacing option: the banner's top padding clears the fixed header. #}
<section data-scheme="{{ scheme }}" class="{{ sectionClass }}">
    {% if layout == 'split' %}
        <div class="mx-auto grid max-w-content items-center gap-12 px-4 md:px-gutter lg:grid-cols-2 lg:gap-12">
            <div class="flex flex-col gap-10 lg:gap-12">
                <div class="flex flex-col gap-4">
                    {% if page.eyebrow %}
                        <p class="w-fit rounded-full border {{ dark ? 'border-graphite' : 'border-line bg-white' }} px-3 py-1 text-sm font-medium">{{ page.eyebrow }}</p>
                    {% endif %}
                    {% if page.heading %}
                        <{{ tag }} class="text-balance text-5xl uppercase md:text-6xl lg:text-7xl">{{ page.heading }}</{{ tag }}>
                    {% endif %}
                    {% if page.text %}
                        <p class="max-w-md text-xl md:text-2xl {{ dark ? 'text-line' : 'text-black/60' }}">{{ page.text|nl2br }}</p>
                    {% endif %}
                </div>
                {% if hasButtons %}{{ _self.buttons(buttons, dark) }}{% endif %}
            </div>

            {% set chat = (page.chatMessages ?? [])|filter(r => r.message or r.kind == 'typing') %}
            {% if chat|length and media|length %}
                {% include '_components/hero-chat.twig' with { messages: chat, images: media, dark: dark } only %}
            {% elseif media|length %}
                <div class="flex justify-center">
                    {% include '_components/image.twig' with {
                        image: media|first,
                        width: 560,
                        sizes: '(min-width: 1024px) 560px, 100vw',
                        eager: true,
                        class: 'h-auto w-full max-w-lg rounded-2xl object-cover',
                    } only %}
                </div>
            {% endif %}
        </div>

    {% elseif layout == 'fullBleed' %}
        {% if media|length %}
            {% include '_components/image.twig' with {
                image: media|first, width: 1600, sizes: '100vw', eager: true,
                class: 'absolute inset-0 size-full object-cover',
            } only %}
            <div class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
        {% endif %}
        <div class="relative mx-auto flex min-h-svh max-w-content flex-col items-center justify-center gap-6 px-4 pt-32 pb-16 text-center md:px-gutter {{ media|length ? 'text-white' }}">
            {% if page.heading %}<{{ tag }} class="text-balance text-5xl md:text-6xl">{{ page.heading }}</{{ tag }}>{% endif %}
            {% if page.text %}<p class="max-w-xl text-xl md:text-2xl">{{ page.text|nl2br }}</p>{% endif %}
            {% if hasButtons %}{{ _self.buttons(buttons, true) }}{% endif %}
        </div>

    {% else %}
        {# centered + simple #}
        <div class="mx-auto flex max-w-content flex-col items-center gap-6 px-4 text-center md:px-gutter">
            {% if page.eyebrow %}<p class="text-2xl font-medium">{{ page.eyebrow }}</p>{% endif %}
            {% if page.heading %}
                <{{ tag }} class="text-balance text-4xl font-medium md:text-6xl">
                    {{ page.heading }}
                    {% set words = page.rotatingWords ?? [] %}
                    {% if words|length %}
                        <span class="block text-accent"
                              x-data="{ words: {{ words|map(r => r.word)|filter|json_encode }}, i: 0 }"
                              x-init="if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => i = (i + 1) % words.length, 2000)"
                              x-text="words[i]">{{ (words|first).word }}</span>
                    {% endif %}
                </{{ tag }}>
            {% endif %}
            {% if page.text and layout != 'simple' %}<p class="max-w-xl text-xl text-black/60 md:text-2xl">{{ page.text|nl2br }}</p>{% endif %}
            {% if hasButtons %}{{ _self.buttons(buttons, dark) }}{% endif %}
            {% if media|length and layout != 'simple' %}
                <div class="mt-6 grid w-full grid-cols-2 gap-4 md:grid-cols-4">
                    {% for image in media %}
                        {% include '_components/image.twig' with { image: image, width: 260, ratio: 1, sizes: '(min-width: 768px) 25vw, 50vw', class: 'aspect-square w-full rounded-lg object-cover' } only %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
</section>
