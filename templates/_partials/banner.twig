{#
 # Page banner (hero): a fixed part of every page, filled in on the entry's Banner tab, not a
 # pageBuilder block (as in Site7 Engine). Figma: Home 6-2210 (split, dark); other layouts are
 # used by landing pages. Included by _entries/page.twig only when the page has a heading or images.
 # The heading is the page's <h1>.
 # Receives: page (the entry)
 # Fields (Banner tab): heroLayout, scheme, eyebrow, heading, rotatingWords, text, buttons (common Matrix), images,
 #         chatMessages (split layout: animated chat over images[0], see _components/hero-chat.twig)
 #}
{% import "_macros/images" as images %}
{% set layout = page.heroLayout.value ?? 'split' %}
{% set scheme = page.scheme.value ?? 'light' %}
{% set dark = scheme == 'dark' %}
{% set media = page.images.eagerly().all() %}
{# h1 on its page; the /blocks library passes headingLevel 3 so it keeps one h1 #}
{% set tag = 'h' ~ (headingLevel ?? 1) %}
{% set buttons = page.buttons.eagerly().all() %}
{% set hasButtons = buttons|filter(b => b.buttonLink.url ?? false)|length > 0 %}
{# Uppercase display headings only on Home; every other page uses sentence case (CLAUDE.md) #}
{% set isHome = (page.type.handle ?? '') == 'home' %}

{% set sectionClass = [
    'relative overflow-hidden',
    layout == 'fullBleed' ? (media|length ? 'h-140 md:h-186' : 'pt-32 pb-16 md:pt-44 lg:pb-24')
    : (layout == 'imageOnly' ? 'px-4 pt-28 md:px-5 md:pt-40'
    : (layout == 'simple' ? 'pt-32 pb-12 md:pt-44 md:pb-20' : 'pt-32 pb-16 md:pt-44 lg:pb-24')),
    (layout == 'centered' or (layout == 'split' and not isHome)) and not dark ? 'glow-bg',
]|join(' ') %}

{% macro buttons(buttons, dark) %}
    {% include '_components/buttons.twig' with {
        buttons: buttons,
        variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'darkOnDark' : 'light' },
        dark: dark, shape: 'rounded', class: 'flex flex-wrap gap-3',
    } only %}
{% endmacro %}

{# No spacing option: the banner's top padding clears the fixed header. #}
<section data-scheme="{{ scheme }}" class="{{ sectionClass }}">
    {% if layout == 'split' %}
        <div class="mx-auto grid max-w-content items-center gap-12 px-4 md:px-gutter lg:grid-cols-2 lg:gap-12">
            <div class="flex flex-col gap-10 lg:gap-12">
                <div class="flex flex-col gap-4">
                    {% if page.eyebrow %}
                        <p class="w-fit rounded-full border {{ dark ? 'border-graphite' : 'border-line bg-white' }} px-3 py-1 text-sm font-medium">{{ page.eyebrow }}</p>
                    {% endif %}
                    {% if page.heading %}
                        <{{ tag }} class="text-balance {{ isHome ? 'text-5xl uppercase md:text-6xl lg:text-7xl' : 'text-4xl font-medium md:text-headline' }}">{{ page.heading }}</{{ tag }}>
                    {% endif %}
                    {% if page.text %}
                        <p class="max-w-md text-xl {{ isHome ? 'md:text-2xl' }} {{ dark ? 'text-line' : 'text-black/60' }}">{{ page.text|nl2br }}</p>
                    {% endif %}
                </div>
                {% if hasButtons %}{{ _self.buttons(buttons, dark) }}{% endif %}
            </div>

            {% set chat = (page.chatMessages ?? [])|filter(r => r.message or r.kind == 'typing') %}
            {% if chat|length and media|length %}
                {% include '_components/hero-chat.twig' with { messages: chat, images: media, dark: dark } only %}
            {% elseif media|length %}
                <div class="flex justify-center">
                    {{ images.singleImg(media|first, 580, { lazy: false, sizes: '(min-width: 1024px) 580px, 100vw' }, 'h-auto w-full max-w-145 rounded-xl object-cover') }}
                </div>
            {% endif %}
        </div>

    {% elseif layout == 'imageOnly' %}
        {# Contact 76:165: the photo inset 20px, radius 8, 1560/484 from lg; no visible heading
           (the page outputs the visually hidden h1) #}
        {% if media|length %}
            <div class="w-full">
                {# art direction: its own 3:2 crop below lg (not the wide crop cut by CSS) #}
                {{ images.singleImg(media|first, 1560, { lazy: false, ratio: 1560 / 484, sizes: '100vw', sources: [{ media: '(max-width: 1023px)', ratio: 3 / 2, width: 1024 }] }, 'h-auto w-full rounded-md object-cover') }}
            </div>
        {% endif %}
        {% if page.heading %}<{{ tag }} class="sr-only">{{ page.heading }}</{{ tag }}>{% endif %}

    {% elseif layout == 'fullBleed' %}
        {# Figma Careers 6-6336: photo edge to edge (745px), white text near the top so the people
           in the photo stay visible. The gradient is only there for contrast. #}
        {% if media|length %}
            {{ images.singleImg(media|first, 1600, { lazy: false, sizes: '100vw' }, 'absolute inset-0 size-full object-cover') }}
            <div class="absolute inset-x-0 top-0 h-2/3 bg-linear-to-b from-black/40 to-transparent" aria-hidden="true"></div>
        {% endif %}
        <div class="relative mx-auto flex max-w-content flex-col items-center gap-2 px-4 text-center md:gap-0 md:px-gutter {{ media|length ? 'pt-32 text-white md:pt-40' }}">
            {% if page.heading %}<{{ tag }} class="text-balance text-5xl font-medium md:text-banner">{{ page.heading }}</{{ tag }}>{% endif %}
            {% if page.text %}<p class="max-w-xl text-xl font-medium md:text-2xl">{{ page.text|nl2br }}</p>{% endif %}
            {% if hasButtons %}{{ _self.buttons(buttons, media|length > 0 or dark) }}{% endif %}
        </div>

    {% else %}
        {# centered (Figma Organizers 17-426: images = a tilted collage around the text, from xl) + simple #}
        {% if layout == 'centered' and media|length %}
            <div class="banner-collage hidden xl:block" aria-hidden="true">
                {% for image in media|slice(0, 15) %}
                    <div>
                        {{ images.singleImg(image, 300, { sizes: '20vw', decorative: true }, 'h-auto w-full rounded-lg shadow-card') }}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
        <div class="relative mx-auto flex max-w-content flex-col items-center gap-6 px-4 text-center md:px-gutter {{ layout == 'centered' and media|length ? 'xl:min-h-110 xl:max-w-200 xl:justify-center' }}">
            {% if page.eyebrow %}<p class="text-xl font-medium {{ dark ? 'text-line' : 'text-black/60' }} md:text-2xl">{{ page.eyebrow }}</p>{% endif %}
            {# simple + images (About 76:458): images[1] = a small emblem above the heading #}
            {% if layout == 'simple' and media|length > 1 %}
                {{ images.singleImg(media[1], 256, { lazy: false, sizes: '256px', decorative: true }, 'h-10 w-auto md:h-14') }}
            {% endif %}
            {% if page.heading %}
                <{{ tag }} class="text-balance text-4xl font-medium md:text-headline">
                    {{ page.heading }}
                    {# filter out empty rows before testing, so an empty table never prints an empty span #}
                    {% set words = (page.rotatingWords ?? [])|map(r => r.word|trim)|filter|values %}
                    {% if words|length %}
                        <span class="block bg-linear-to-r from-success to-lime bg-clip-text pb-1 text-transparent"
                              x-data="{ words: {{ words|json_encode }}, i: 0 }"
                              x-init="if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => i = (i + 1) % words.length, 2000)"
                              x-text="words[i]">{{ words|first }}</span>
                    {% endif %}
                </{{ tag }}>
            {% endif %}
            {% if page.text and layout != 'simple' %}<p class="max-w-xl text-xl text-black/60 md:text-2xl">{{ page.text|nl2br }}</p>{% endif %}
            {% if hasButtons %}{{ _self.buttons(buttons, dark) }}{% endif %}
            {# simple + images (About 76:458): images[0] = the big photo under the heading, 960×600 #}
            {% if layout == 'simple' and media|length %}
                {{ images.singleImg(media|first, 960, { lazy: false, ratio: 960 / 600, sizes: '(min-width: 1024px) 960px, 100vw' }, 'mt-8 h-auto w-full max-w-240 rounded-xl object-cover md:mt-14') }}
            {% endif %}
        </div>
    {% endif %}
</section>
