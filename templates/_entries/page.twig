{#
 # Generic page template — Home, Landing pages, Careers, Press.
 # Entry tabs (as in Site7 Engine): Page · Banner · Content · SEO.
 #   Banner  → _partials/banner.twig (fixed per page; its heading is the page's <h1>)
 #   Content → each pageBuilder block renders from _blocks/{entryTypeHandle}.twig with headingLevel 2
 # A page without a banner heading still gets one <h1>: the entry title, visually hidden.
 #}
{% extends '_layouts/base.twig' %}

{# Page tab: pageBackground. Light sections have no background of their own, so they show this. #}
{% block bodyBg %}{{ (entry.pageBackground.value ?? 'paper') == 'surface' ? 'bg-surface' : 'bg-paper' }}{% endblock %}

{% block content %}
    {% if entry.heading or entry.images.exists() %}
        {% include '_partials/banner.twig' with { page: entry } only %}
    {% endif %}
    {% if not entry.heading %}
        <h1 class="sr-only">{{ entry.title }}</h1>
    {% endif %}

    {% for block in entry.pageBuilder.eagerly().all() %}
        {% include '_blocks/' ~ block.type.handle ~ '.twig' ignore missing with {
            block: block,
            headingLevel: 2,
        } only %}
    {% endfor %}
{% endblock %}
