{#
 # Card grid block.
 #   grid (default): Figma Home 6-1320 — centered heading, big cards, button below
 #   compact:        Figma Home 6-1719 — heading left + buttons right, small square tiles
 #   textCards:      Figma Careers 6-6770 — centred heading, white emoji cards (image on top if set, Organizers 17-728)
 #   photoCards:     Figma Organizers 17-782 — text over full-bleed photos
 # Receives: block, headingLevel
 # Fields: cardLayout, scheme, spacing, glow (textCards only), eyebrow, heading, text, cards, buttons (common Matrix)
 #}
{% set layout = block.cardLayout.value ?? 'grid' %}
{% set compact = layout == 'compact' %}
{% set photoCards = layout == 'photoCards' %}
{% set textCards = layout == 'textCards' or photoCards %}
{% set scheme = block.scheme.value ?? 'light' %}
{% set dark = scheme == 'dark' %}
{% set cards = block.cards.eagerly().with(['image']).all() %}
{% set level = headingLevel ?? 2 %}
{% set count = cards|length %}
{% set cols = count == 1 ? 'max-w-md'
    : (count == 2 ? 'sm:grid-cols-2'
    : (count == 3 ? 'sm:grid-cols-2 lg:grid-cols-3'
    : 'sm:grid-cols-2 lg:grid-cols-4')) %}
{% set buttons = block.buttons.eagerly().all() %}

{% if layout in ['showcase', 'carousel', 'bento'] and (block.heading or count) %}
{# Left-header layouts (Sell Tickets): showcase 17-2788 (big image cards), carousel 17-4296 (scroll-snap
   row of the same cards), bento 17-3995 (panels, the first spans two rows) #}
{% set muted = dark ? 'text-white/80' : 'text-black/60' %}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}" class="flex flex-col gap-10 py-16 md:gap-14 md:py-25 {{ layout == 'carousel' ? 'overflow-hidden' }}">
    {% if block.eyebrow or block.heading or block.text or buttons|length %}
        <div class="mx-auto flex w-full max-w-site flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between md:px-gutter" data-reveal>
            <div class="flex flex-col gap-3">
                {% if block.eyebrow %}<p class="text-xl font-medium text-accent">{{ block.eyebrow }}</p>{% endif %}
                {% if block.heading %}<{{ 'h' ~ level }} class="text-balance text-4xl font-bold md:text-6xl">{{ block.heading }}</{{ 'h' ~ level }}>{% endif %}
                {% if block.text %}<p class="text-xl md:text-title {{ muted }}">{{ block.text|nl2br }}</p>{% endif %}
            </div>
            {% include '_components/buttons.twig' with {
                buttons: buttons, dark: dark, shape: 'rounded', class: 'flex shrink-0 flex-wrap gap-3',
                variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'outlineLight' : 'light' },
            } only %}
        </div>
    {% endif %}

    {% if count and layout == 'carousel' %}
        {# runs to the right edge; starts at the content's left edge #}
        <ul class="scroll-row flex gap-5" tabindex="0" aria-label="{{ block.heading ?: 'Features'|t }}">
            {% for card in cards %}
                <li class="w-64 shrink-0 snap-start md:w-75">
                    {% include '_components/card.twig' with { card: card, level: level + 1, dark: dark, variant: 'showcase', ratio: 300 / 236, revealIndex: loop.index0 } only %}
                </li>
            {% endfor %}
        </ul>
    {% elseif count %}
        <div class="mx-auto w-full max-w-site px-4 md:px-gutter">
            {% if layout == 'bento' %}
                <div class="grid gap-6 lg:grid-cols-2 lg:grid-rows-2">
                    {% for card in cards %}
                        {% include '_components/card.twig' with { card: card, level: level + 1, dark: dark, variant: 'panel', wide: loop.first, class: loop.first ? 'lg:row-span-2', revealIndex: loop.index0 } only %}
                    {% endfor %}
                </div>
            {% else %}
                <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
                    {% for card in cards %}
                        {% include '_components/card.twig' with { card: card, level: level + 1, dark: dark, variant: 'showcase', ratio: 450 / 532, revealIndex: loop.index0 } only %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    {% endif %}
</section>

{% elseif textCards and (block.heading or count or buttons|length) %}
{# Text cards (Careers 6-6770 "Our Values"; with images: Organizers 17-728) and photo cards
   (Organizers 17-782): sentence-case heading group, cards, buttons, optional glow. With no cards it's
   a plain heading + text + buttons call to action (Organizers "Get started for free"). #}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}"
         class="px-4 py-16 md:px-gutter md:py-25 {{ block.glow and not dark ? 'glow-bg' }}">
    {# no cards = the "Get started for free" call to action (partiful.com/org-profiles): a one-line
       subtitle at 1440 (max-w-200), heading → text 16, text → buttons 36 #}
    <div class="mx-auto flex max-w-narrow flex-col items-center {{ count ? 'gap-10 md:gap-15' : 'gap-8 md:gap-9' }}">
        {% if block.eyebrow or block.heading or block.text %}
            <div class="flex flex-col items-center text-center {{ count ? 'gap-3' : 'gap-4' }}" data-reveal>
                {% if block.eyebrow %}<p class="text-xl font-medium text-accent">{{ block.eyebrow }}</p>{% endif %}
                {% if block.heading %}
                    <{{ 'h' ~ level }} class="text-balance text-4xl font-medium md:text-headline">{{ block.heading }}</{{ 'h' ~ level }}>
                {% endif %}
                {% if block.text %}
                    <p class="{{ count ? 'max-w-article' : 'max-w-200' }} text-balance text-xl md:text-2xl {{ dark ? 'text-line' : 'text-black/60' }}">{{ block.text|nl2br }}</p>
                {% endif %}
            </div>
        {% endif %}
        {% if count %}
            {% set withImages = cards|filter(c => c.image|length)|length > 0 %}
            <div class="grid w-full grid-cols-1 {{ photoCards ? 'gap-4 md:grid-cols-3' : (withImages ? 'gap-5' : 'gap-2.5') ~ ' sm:auto-rows-fr sm:grid-cols-2 lg:grid-cols-3' }}">
                {% for card in cards %}
                    {% include '_components/card.twig' with { card: card, level: level + 1, dark: dark, variant: photoCards ? 'photo' : 'text', revealIndex: loop.index0 } only %}
                {% endfor %}
            </div>
        {% endif %}
        {% include '_components/buttons.twig' with {
            buttons: buttons, dark: dark, shape: 'rounded', class: 'flex flex-wrap justify-center gap-3',
            variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'outlineLight' : 'light' },
        } only %}
    </div>
</section>

{% elseif block.heading or count %}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}" class="px-4 md:px-gutter {{ compact ? 'py-16 md:py-28' : 'pt-16 pb-20 md:pt-24 md:pb-section' }}">
    <div class="mx-auto flex max-w-site flex-col gap-10 md:gap-14 {{ compact ? 'items-stretch' : 'items-center' }}">

        {% if compact %}
            <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
                {% include '_components/section-heading.twig' with {
                    eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level, dark: dark, align: 'left',
                } only %}
                {% include '_components/buttons.twig' with {
                    buttons: buttons, dark: dark, class: 'flex flex-wrap gap-2',
                    variants: { primary: dark ? 'outlineLight' : 'light', secondary: dark ? 'light' : 'dark' },
                } only %}
            </div>
        {% else %}
            {% include '_components/section-heading.twig' with {
                eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level, dark: dark,
            } only %}
        {% endif %}

        {% if count %}
            <div class="grid w-full grid-cols-1 {{ compact ? 'gap-x-7 gap-y-10' : 'gap-x-7 gap-y-12' }} {{ cols }}">
                {% for card in cards %}
                    {% include '_components/card.twig' with { card: card, level: level + 1, dark: dark, soft: scheme == 'soft', variant: compact ? 'compact' : 'feature', revealIndex: loop.index0 } only %}
                {% endfor %}
            </div>
        {% endif %}

        {% if not compact %}
            {% include '_components/buttons.twig' with {
                buttons: buttons, dark: dark, shape: 'rounded', class: 'flex flex-wrap justify-center gap-3',
                variants: { primary: dark ? 'light' : 'darkOnDark', secondary: dark ? 'outlineLight' : 'light' },
            } only %}
        {% endif %}
    </div>
</section>
{% endif %}
