{#
 # Image gallery block. Figma: Home 6-1384 (fan; motion/hover/resize measured on the reference
 # site, see src/js/gallery-wave.js). Also grid (17-1088), row (17-1931), marquee (17-3649).
 # Receives: block, headingLevel
 # Fields: galleryLayout, eyebrow, heading, text, images, buttons (common Matrix)
 # Captions use each asset's title (grid/row layouts only). spacing applies to every layout but fan.
 # Marquee: fixed-height tiles at each image's own ratio (Careers 6-6667, Sell Tickets 17-3649).
 #}
{% import "_macros/images" as images %}
{% set layout = block.galleryLayout.value ?? 'grid' %}
{% set images = block.images.eagerly().all() %}
{% set buttons = block.buttons.eagerly().all() %}
{% set buttonVariants = { primary: 'dark', secondary: 'light' } %}
{% set level = headingLevel ?? 2 %}

{% if layout == 'fan' and images|length %}
{# Fan (reference: partiful.com, measured): the gallery is one viewport tall (596px below
   1200px wide) with the heading behind it at the top left; cards drift along a wavy diagonal,
   react to scroll, drag and hover (src/js/gallery-wave.js, .gallery-fan in app.css). #}
{# overflow-x-clip (not overflow-hidden): lifted cards may rise above the section, as on the reference #}
<section class="relative overflow-x-clip">
    <div class="gallery-fan" data-gallery-wave>
        <ul class="gallery-fan__row" aria-label="{{ block.heading ?: 'Gallery'|t }}">
            {% for image in images %}
                <li class="gallery-fan__item">
                    <div class="gallery-fan__lift">
                        <div class="gallery-fan__media">
                            {{ images.singleImg(image, 260, { ratio: 1, sizes: '(min-width: 810px) 17vw, 33vw' }, 'size-full object-cover') }}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
    {% if block.heading or block.text %}
        {# under the cards (the gallery has z-index 1), 128px from the top — as on the reference #}
        <div class="pointer-events-none absolute inset-x-0 top-0 z-0">
            <div class="mx-auto max-w-site px-4 pt-12 md:px-gutter md:pt-section">
                {% include '_components/section-heading.twig' with {
                    eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level,
                    align: 'left', class: 'max-w-lg',
                } only %}
            </div>
        </div>
    {% endif %}
    {% include '_components/buttons.twig' with { buttons: buttons, variants: buttonVariants, shape: 'rounded', class: 'flex flex-wrap justify-center gap-3 px-4 pb-16' } only %}
</section>

{% elseif block.heading or images|length %}
{% set hasHeading = block.eyebrow or block.heading or block.text %}
{% set scheme = block.scheme.value ?? 'light' %}
{% set dark = scheme == 'dark' %}
{# a marquee with a heading = poster strip (Sell Tickets 17-3649); without = photo strip (Careers 6-6667) #}
{% set posters = layout == 'marquee' and hasHeading %}
{% set leftHeading = layout == 'row' or posters %}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}" class="overflow-hidden py-16 md:py-section">
    {% if hasHeading %}
        {# row (Invitation Maker 17-1931) and poster marquee: heading left; others centred #}
        <div class="mx-auto flex flex-col gap-10 px-4 md:px-gutter {{ layout == 'row' ? 'max-w-narrow items-start lg:px-0' : (posters ? 'max-w-site items-start' : 'max-w-site items-center') }}">
            {% if posters %}
                <div class="flex flex-col gap-3" data-reveal>
                    {% if block.eyebrow %}<p class="text-xl font-medium text-accent">{{ block.eyebrow }}</p>{% endif %}
                    {% if block.heading %}<{{ 'h' ~ level }} class="text-balance text-4xl font-bold md:text-6xl">{{ block.heading }}</{{ 'h' ~ level }}>{% endif %}
                    {% if block.text %}<p class="text-xl md:text-title {{ dark ? 'text-white/80' : 'text-black/60' }}">{{ block.text|nl2br }}</p>{% endif %}
                </div>
            {% else %}
                {% include '_components/section-heading.twig' with {
                    eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level, dark: dark,
                    align: leftHeading ? 'left' : 'center', plain: true,
                } only %}
            {% endif %}
        </div>
    {% endif %}

    {% if images|length %}
        {% if layout == 'marquee' %}
            {# Fixed-height tiles at each image's own ratio (Careers 6-6667: 220px, gap 10, radius 10).
               Two passes so the -50% loop is seamless; the copy is hidden from screen readers. #}
            {# Each half of the track (the loop moves it by -50%) must be wider than the widest screen,
               so the photos repeat until a half is at least 2400px; only the first set is read out. #}
            {% set tileHeight = posters ? 300 : 220 %}
            {% set gap = posters ? 24 : 10 %}
            {% set tileWidths = images|map(i => i.height ? (tileHeight * i.width / i.height)|round : tileHeight) %}
            {% set setWidth = tileWidths|reduce((sum, w) => sum + w + gap, 0) %}
            {% set copies = max(1, (2400 / max(setWidth, 1))|round(0, 'ceil')) %}
            <div class="{{ hasHeading ? 'mt-10 md:mt-14' }} overflow-hidden">
                <ul class="gallery-marquee__track {{ posters ? 'gap-4 md:gap-6' : 'gap-2.5' }}" aria-label="{{ block.heading ?: 'Gallery'|t }}">
                    {% for pass in 1..(copies * 2) %}
                        {% for image in images %}
                            {% set tileWidth = tileWidths[loop.index0] %}
                            <li class="flex-none {{ posters ? 'h-55 md:h-75' : 'h-40 md:h-55' }}" {% if pass > 1 %}aria-hidden="true"{% endif %}>
                                {{ images.singleImg(image, tileWidth, { sizes: tileWidth ~ 'px', decorative: pass > 1 }, 'h-full w-auto object-cover ' ~ (posters ? 'rounded-md' : 'rounded-photo')) }}
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>

        {% else %}
            {# grid (Birthday 17-1088: 3:2 tiles, 3 columns, gap 20 × 52) + row (square tiles): captioned #}
            {% set isRow = layout == 'row' %}
            <ul class="mx-auto mt-10 grid max-w-narrow px-4 md:mt-6 md:px-gutter lg:px-0 {{ isRow ? 'grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:grid-cols-6' : 'grid-cols-1 gap-x-5 gap-y-8 sm:grid-cols-2 md:grid-cols-3 md:gap-y-13' }}">
                {% for image in images %}
                    <li>
                        <figure class="flex flex-col gap-3">
                            {{ images.singleImg(image, isRow ? 180 : 320, { ratio: isRow ? 1 : 3 / 2, sizes: isRow ? '(min-width: 1024px) 16vw, 50vw' : '(min-width: 768px) 320px, (min-width: 640px) 50vw, 100vw' }, (isRow ? 'aspect-square rounded-xl' : 'aspect-3/2 rounded-md') ~ ' w-full object-cover') }}
                            {% if image.title %}
                                <figcaption class="text-center {{ isRow ? 'text-xl font-semibold' : 'text-lg font-bold' }}">{{ image.title }}</figcaption>
                            {% endif %}
                        </figure>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}

    {% if (block.note ?? '')|trim %}
        <p class="mt-10 px-4 text-center text-xl text-black/60 md:mt-15 md:text-2xl">{{ block.note }}</p>
    {% endif %}
    {% include '_components/buttons.twig' with { buttons: buttons, variants: buttonVariants, shape: 'rounded', class: ((block.note ?? '')|trim ? 'mt-6 ' : (hasHeading or images|length ? 'mt-10 ' : '')) ~ 'flex flex-wrap justify-center gap-3 px-4' } only %}
</section>
{% endif %}
