{#
 # Image gallery block. Figma: Home 6-1384 (fan; motion/hover/resize measured on the reference
 # site, see src/js/gallery-wave.js). Also grid (17-1088), row (17-1931), marquee (17-3649).
 # Receives: block, headingLevel
 # Fields: galleryLayout, eyebrow, heading, text, images, buttons (common Matrix)
 # Captions use each asset's title (grid/row layouts only). spacing applies to every layout but fan.
 # Marquee: fixed-height tiles at each image's own ratio (Careers 6-6667, Sell Tickets 17-3649).
 #}
{% set layout = block.galleryLayout.value ?? 'grid' %}
{% set images = block.images.eagerly().all() %}
{% set buttons = block.buttons.eagerly().all() %}
{% set buttonVariants = { primary: 'dark', secondary: 'light' } %}
{% set level = headingLevel ?? 2 %}

{% if layout == 'fan' and images|length %}
{# Fan (reference: partiful.com, measured): the gallery is one viewport tall (596px below
   1200px wide) with the heading behind it at the top left; cards drift along a wavy diagonal,
   react to scroll, drag and hover (src/js/gallery-wave.js, .gallery-fan in app.css). #}
{# overflow-x-clip (not overflow-hidden): lifted cards may rise above the section, as on the reference #}
<section class="relative overflow-x-clip">
    <div class="gallery-fan" data-gallery-wave>
        <ul class="gallery-fan__row" aria-label="{{ block.heading ?: 'Gallery'|t }}">
            {% for image in images %}
                <li class="gallery-fan__item">
                    <div class="gallery-fan__lift">
                        <div class="gallery-fan__media">
                            {% include '_components/image.twig' with { image: image, width: 260, ratio: 1, sizes: '(min-width: 810px) 17vw, 33vw', class: 'size-full object-cover' } only %}
                        </div>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
    {% if block.heading or block.text %}
        {# under the cards (the gallery has z-index 1), 128px from the top — as on the reference #}
        <div class="pointer-events-none absolute inset-x-0 top-0 z-0">
            <div class="mx-auto max-w-site px-4 pt-12 md:px-gutter md:pt-section">
                {% include '_components/section-heading.twig' with {
                    eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level,
                    align: 'left', class: 'max-w-lg',
                } only %}
            </div>
        </div>
    {% endif %}
    {% include '_components/buttons.twig' with { buttons: buttons, variants: buttonVariants, shape: 'rounded', class: 'flex flex-wrap justify-center gap-3 px-4 pb-16' } only %}
</section>

{% elseif block.heading or images|length %}
{% set hasHeading = block.eyebrow or block.heading or block.text %}
<section data-spacing="{{ block.spacing.value ?? 'default' }}" class="overflow-hidden py-16 md:py-section">
    {% if hasHeading %}
        <div class="mx-auto flex max-w-site flex-col items-center gap-10 px-4 md:px-gutter">
            {% include '_components/section-heading.twig' with {
                eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level,
                align: 'center',
            } only %}
        </div>
    {% endif %}

    {% if images|length %}
        {% if layout == 'marquee' %}
            {# Fixed-height tiles at each image's own ratio (Careers 6-6667: 220px, gap 10, radius 10).
               Two passes so the -50% loop is seamless; the copy is hidden from screen readers. #}
            {# Each half of the track (the loop moves it by -50%) must be wider than the widest screen,
               so the photos repeat until a half is at least 2400px; only the first set is read out. #}
            {% set tileWidths = images|map(i => i.height ? (220 * i.width / i.height)|round : 220) %}
            {% set setWidth = tileWidths|reduce((sum, w) => sum + w + 10, 0) %}
            {% set copies = max(1, (2400 / max(setWidth, 1))|round(0, 'ceil')) %}
            <div class="{{ hasHeading ? 'mt-10' }} overflow-hidden">
                <ul class="gallery-marquee__track gap-2.5" aria-label="{{ block.heading ?: 'Gallery'|t }}">
                    {% for pass in 1..(copies * 2) %}
                        {% for image in images %}
                            {% set tileWidth = tileWidths[loop.index0] %}
                            <li class="h-40 flex-none md:h-55" {% if pass > 1 %}aria-hidden="true"{% endif %}>
                                {% include '_components/image.twig' with {
                                    image: image, width: tileWidth, sizes: tileWidth ~ 'px',
                                    decorative: pass > 1,
                                    class: 'h-full w-auto rounded-photo object-cover',
                                } only %}
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>

        {% else %}
            {# grid + row: captioned tiles #}
            <ul class="mx-auto mt-10 grid max-w-narrow grid-cols-2 gap-x-4 gap-y-8 px-4 md:px-gutter {{ layout == 'row' ? 'sm:grid-cols-3 lg:grid-cols-6' : 'md:grid-cols-3' }}">
                {% for image in images %}
                    <li>
                        <figure class="flex flex-col gap-3">
                            {% include '_components/image.twig' with {
                                image: image, width: layout == 'row' ? 180 : 320, ratio: 1,
                                sizes: layout == 'row' ? '(min-width: 1024px) 16vw, 50vw' : '(min-width: 768px) 33vw, 50vw',
                                class: 'aspect-square w-full rounded-md object-cover',
                            } only %}
                            {% if image.title %}
                                <figcaption class="text-center text-lg font-bold">{{ image.title }}</figcaption>
                            {% endif %}
                        </figure>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}

    {% include '_components/buttons.twig' with { buttons: buttons, variants: buttonVariants, shape: 'rounded', class: (hasHeading or images|length ? 'mt-10 ' : '') ~ 'flex flex-wrap justify-center gap-3 px-4' } only %}
</section>
{% endif %}
