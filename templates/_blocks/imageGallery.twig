{#
 # Image gallery block. Figma: Home 6-1384 (fan). Also grid (17-1088), row (17-1931),
 # marquee (17-3649).
 # Receives: block, headingLevel
 # Fields: galleryLayout, eyebrow, heading, text, images, primaryButton
 # Captions use each asset's title (grid/row layouts only).
 #}
{% set layout = block.galleryLayout.value ?? 'grid' %}
{% set images = block.images.eagerly().all() %}
{% set level = headingLevel ?? 2 %}

{% if block.heading or images|length %}
<section class="overflow-hidden py-16 md:py-section">
    <div class="mx-auto flex max-w-site flex-col gap-10 px-4 md:px-gutter {{ layout == 'fan' ? 'items-start' : 'items-center' }}">
        {% include '_components/section-heading.twig' with {
            eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level,
            align: layout == 'fan' ? 'left' : 'center',
            class: layout == 'fan' ? 'max-w-lg md:relative md:z-10' : '',
        } only %}
    </div>

    {% if images|length %}
        {% if layout == 'fan' %}
            {# Mobile: swipeable row. md+: perspective fan #}
            <ul class="mt-8 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-4 md:hidden" aria-label="{{ block.heading ?: 'Gallery'|t }}">
                {% for image in images %}
                    <li class="w-48 flex-none snap-start">
                        {% include '_components/image.twig' with { image: image, width: 192, ratio: 1, sizes: '192px', class: 'aspect-square w-full rounded-md object-cover shadow-card' } only %}
                    </li>
                {% endfor %}
            </ul>
            <div class="gallery-fan hidden pt-24 pl-8 md:block lg:pt-40" data-gallery-wave>
                <ul class="gallery-fan__row" aria-label="{{ block.heading ?: 'Gallery'|t }}">
                    {% for image in images %}
                        <li class="gallery-fan__item">
                            {% include '_components/image.twig' with { image: image, width: 256, ratio: 1, sizes: '256px', class: 'aspect-square w-full rounded-md object-cover shadow-card' } only %}
                        </li>
                    {% endfor %}
                </ul>
            </div>

        {% elseif layout == 'marquee' %}
            <div class="mt-10 overflow-hidden">
                <ul class="gallery-marquee__track gap-4" aria-label="{{ block.heading ?: 'Gallery'|t }}">
                    {% for pass in 1..2 %}
                        {% for image in images %}
                            <li class="w-56 flex-none" {% if pass == 2 %}aria-hidden="true"{% endif %}>
                                {% include '_components/image.twig' with { image: image, width: 224, ratio: 1, sizes: '224px', decorative: pass == 2, class: 'aspect-square w-full rounded-md object-cover' } only %}
                            </li>
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>

        {% else %}
            {# grid + row: captioned tiles #}
            <ul class="mx-auto mt-10 grid max-w-narrow grid-cols-2 gap-x-4 gap-y-8 px-4 md:px-gutter {{ layout == 'row' ? 'sm:grid-cols-3 lg:grid-cols-6' : 'md:grid-cols-3' }}">
                {% for image in images %}
                    <li>
                        <figure class="flex flex-col gap-3">
                            {% include '_components/image.twig' with {
                                image: image, width: layout == 'row' ? 180 : 320, ratio: 1,
                                sizes: layout == 'row' ? '(min-width: 1024px) 16vw, 50vw' : '(min-width: 768px) 33vw, 50vw',
                                class: 'aspect-square w-full rounded-md object-cover',
                            } only %}
                            {% if image.title %}
                                <figcaption class="text-center text-lg font-bold">{{ image.title }}</figcaption>
                            {% endif %}
                        </figure>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}

    {% if block.primaryButton.url ?? false %}
        <div class="mt-10 flex justify-center px-4">
            {% include '_components/button.twig' with { link: block.primaryButton, variant: 'dark', shape: 'rounded' } only %}
        </div>
    {% endif %}
</section>
{% endif %}
