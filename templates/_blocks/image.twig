{#
 # Image block. Figma: Careers 6-7092 (a full-width photo, 1600×1066).
 # One image edge to edge at its own ratio (never cropped), with an optional caption.
 # Receives: block, headingLevel (not used)
 # Fields: image, text (caption)
 #}
{% set image = block.image.eagerly().one() %}
{% if image %}
    <figure>
        {% include '_components/image.twig' with {
            image: image, width: 1600, sizes: '100vw',
            class: 'h-auto w-full',
        } only %}
        {% if block.text|trim %}
            <figcaption class="px-4 pt-3 text-center text-sm text-black/60 md:px-gutter">{{ block.text }}</figcaption>
        {% endif %}
    </figure>
{% endif %}
