{#
 # CTA banner block. Figma: Home 6-1787 ("Get the app").
 # Big pill heading (links to primaryButton if set), subtitle, optional buttons and
 # store links (showAppBadges). Images (if any) behind it, by ctaLayout:
 #   spiral (default) — a slowly turning oval spiral (src/js/cta-spiral.js)
 #   rows             — collage rows sliding sideways at random speeds (src/js/cta-rows.js)
 #   rowsSpot         — the same rows in grayscale; colour shows in a circle around the cursor
 #   rowsSpotInvert   — the reverse: rows in colour; a grayscale circle follows the cursor
 #   simple           — Figma Birthday 17-1368: plain heading + text + badges, no images
 # Receives: block, headingLevel
 # Fields: scheme, spacing, ctaLayout, heading, text, primaryButton (= heading link), buttons (common Matrix), images, showAppBadges
 #}
{% import "_macros/images" as images %}
{% set scheme = block.scheme.value ?? 'light' %}
{% set dark = scheme == 'dark' %}
{% set images = block.images.eagerly().all() %}
{% set level = headingLevel ?? 2 %}
{% set tag = 'h' ~ level %}
{% set headingLink = block.primaryButton.url ?? null %}

{% if (block.ctaLayout.value ?? '') == 'simple' and (block.heading or block.text) %}
{# Simple (Figma Birthday 17-1368): plain centred heading + text, buttons and store badges; no images #}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}" class="px-4 py-16 md:px-10 md:py-25 {{ (block.glow ?? false) and not dark ? 'glow-bg' }}">
    <div class="mx-auto flex max-w-content flex-col items-center gap-10 text-center md:gap-15">
        {% if images|length and (block.imageAbove ?? false) %}
            {# a small sticker above a normal heading (About 76:832 "PARTY!") #}
            <div class="flex flex-col items-center gap-10">
                {{ images.singleImg(images|first, 172, { sizes: '172px', decorative: true }, 'h-13 w-auto') }}
                {% include '_components/section-heading.twig' with { heading: block.heading, text: block.text, level: level, dark: dark, plain: true } only %}
            </div>
        {% elseif images|length %}
            {# with an image (Sell Tickets 17-2992 "See you at the door."): a big bold heading, the image below #}
            <div class="flex flex-col items-center gap-3">
                {% if block.heading %}<{{ tag }} class="text-balance text-5xl font-bold md:text-banner">{{ block.heading }}</{{ tag }}>{% endif %}
                {% if block.text %}<p class="text-xl md:text-2xl {{ dark ? 'text-line' : 'text-black/60' }}">{{ block.text|nl2br }}</p>{% endif %}
            </div>
            {{ images.singleImg(images|first, 512, { sizes: '(min-width: 768px) 512px, 90vw' }, 'h-auto w-full max-w-128 rounded-lg shadow-glow') }}
        {% else %}
            {% include '_components/section-heading.twig' with { heading: block.heading, text: block.text, level: level, dark: dark, plain: true } only %}
        {% endif %}
        {% set buttons = block.buttons.eagerly().all() %}
        {% if buttons|length or block.showAppBadges %}
            <div class="flex flex-col items-center gap-4">
                {% include '_components/buttons.twig' with {
                    buttons: buttons, dark: dark, shape: 'rounded', class: 'flex flex-wrap justify-center gap-3',
                    variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'darkOnDark' : 'light' },
                } only %}
                {% if block.showAppBadges %}
                    {% include '_components/store-links.twig' with { dark: dark, class: 'justify-center' } %}
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>

{% elseif block.heading or block.text %}
{# Measured on the reference: section 700px tall (388 on a phone); the pill is centred on the
   section (= the spiral's centre); the subtitle hangs 8px below it, outside the centring. #}
<section data-scheme="{{ scheme }}" data-spacing="{{ block.spacing.value ?? 'default' }}" class="relative flex min-h-97 flex-col justify-center overflow-hidden px-4 py-24 md:min-h-175">

    {% set ctaLayout = block.ctaLayout.value ?? 'spiral' %}
    {% if images|length and ctaLayout in ['rows', 'rowsSpot', 'rowsSpotInvert'] %}
        {# Collage rows (src/js/cta-rows.js): full-width rows of straight square images; each row
           slides sideways at a random speed and direction (chosen on each page load) and loops
           seamlessly (the row's set is rendered twice). Decoration only. #}
        {% set rowCount = 6 %}
        {% set perRow = 14 %}
        {# the rows share the section height (minus an even top/bottom margin), so every row of
           images sits fully inside the section — nothing cut at the top or bottom #}
        {# rowsSpot: grayscale, colour shows in a circle around the cursor;
           rowsSpotInvert: the reverse — colour, with a grayscale circle (cta-rows.js) #}
        {% set spot = { rowsSpot: 'colour', rowsSpotInvert: 'gray' }[ctaLayout] ?? null %}
        <div class="cta-rows pointer-events-none absolute inset-0 flex flex-col justify-center gap-2 py-3 md:gap-3 md:py-6" data-cta-rows {% if spot %}data-cta-spotlight="{{ spot }}"{% endif %} aria-hidden="true">
            {% for r in 0..(rowCount - 1) %}
                <div class="cta-rows__row flex w-max gap-2 md:gap-3">
                    {% for pass in 1..2 %}
                        {% for k in 0..(perRow - 1) %}
                            {% set image = images[(r * 5 + k * 3) % images|length] %}
                            <div class="cta-rows__item">
                                {{ images.singleImg(image, 120, { ratio: 1, sizes: '120px', decorative: true }, 'aspect-square size-full object-cover') }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

    {% elseif images|length %}
        {# Turning image spiral (reference: partiful.com, measured; src/js/cta-spiral.js).
           240 slots cycle through the images; JS shows as many as the section needs
           (≈140 on desktop, ≈210 on a phone), sizes and places them. Decoration only. #}
        <ul class="cta-spiral pointer-events-none absolute inset-0" data-cta-spiral aria-hidden="true">
            {% for i in 0..239 %}
                {% set image = images[i % images|length] %}
                <li class="cta-spiral__item">
                    {{ images.singleImg(image, 140, { ratio: 1, sizes: '140px', decorative: true }, 'aspect-square w-full object-cover') }}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <div class="relative mx-auto flex max-w-content flex-col items-center text-center">
        {% if block.heading %}
            {# pill: 170×64 on a phone (20/28 padding, 24px), 350×114 from md (32/56, 50px);
               light: soft page-coloured halo hides the spiral right behind it (Figma 6-2046) #}
            {% set pill = 'inline-flex items-center justify-center rounded-full px-7 py-5 text-2xl leading-none tracking-loose uppercase md:px-14 md:py-8 md:text-5xl md:leading-none ' ~ (dark ? 'bg-paper text-ink' : 'bg-ink text-white shadow-halo') %}
            <{{ tag }}>
                {% if headingLink %}
                    <a {{ attr(block.primaryButton.attributes|merge({ class: pill ~ ' transition-transform hover:scale-105' })) }}>{{ block.heading }}</a>
                {% else %}
                    <span class="{{ pill }}">{{ block.heading }}</span>
                {% endif %}
            </{{ tag }}>
        {% endif %}

        {# below the pill, not part of the centring #}
        {# own width (not the pill's): on a phone the subtitle is one line, wider than the pill #}
        <div class="{{ block.heading ? 'absolute top-full left-1/2 mt-2 w-max max-w-xs -translate-x-1/2' }} flex flex-col items-center gap-4">
            {% if block.text %}
                {# 16/19 with 8px padding on a phone, 18/22 with 12px and two lines (237 wide) from md #}
                <p class="p-2 text-base leading-4.75 font-light text-balance md:max-w-60 md:p-3 md:text-lg md:leading-5.5 {{ dark ? 'bg-night text-line' : (scheme == 'soft' ? 'bg-white text-graphite' : 'bg-surface text-graphite') }}">{{ block.text|nl2br }}</p>
            {% endif %}

            {% include '_components/buttons.twig' with {
                buttons: block.buttons.eagerly().all(), dark: dark, class: 'mt-2 flex flex-wrap justify-center gap-3',
                variants: { primary: dark ? 'light' : 'dark', secondary: dark ? 'darkOnDark' : 'light' },
            } only %}

            {% if block.showAppBadges %}
                {% include '_components/store-links.twig' with { dark: dark, class: 'mt-2 justify-center' } %}
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
