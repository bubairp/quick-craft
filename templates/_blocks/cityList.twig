{#
 # City list block. Figma: Home 6-4774.
 # Big centered city names; the active city (first by default, or hovered/focused)
 # shows its link label and, on lg+, its event thumbnails on both sides.
 # Receives: block, headingLevel
 # Fields: heading, text, cards (card: heading = city, primaryButton = link, images = thumbnails)
 #}
{% set cities = block.cards.eagerly().with(['images']).all() %}
{% set level = headingLevel ?? 2 %}

{% if cities|length %}
<section class="overflow-hidden bg-paper py-16 md:py-36" x-data="{ active: 0 }">
    {% include '_components/section-heading.twig' with {
        heading: block.heading, text: block.text, level: level, class: 'px-4 md:px-gutter',
    } only %}

    <ul class="mt-12 flex flex-col items-center gap-6 md:mt-18 md:gap-10">
        {% for city in cities %}
            {% set i = loop.index0 %}
            {% set link = city.primaryButton ?? null %}
            {% set thumbs = city.images.all() %}
            {% set tag = 'h' ~ (level + 1) %}
            <li class="relative flex w-full justify-center px-4"
                @mouseenter="active = {{ i }}" @focusin="active = {{ i }}">

                {% if thumbs|length %}
                    {% set half = (thumbs|length / 2)|round(0, 'ceil') %}
                    {% for side in [thumbs|slice(0, half), thumbs|slice(half)] %}
                        <div class="pointer-events-none absolute top-1/2 hidden -translate-y-1/2 gap-4 transition-opacity lg:flex {{ loop.first ? 'right-1/2 mr-72 flex-row-reverse' : 'left-1/2 ml-72' }}"
                             :class="active === {{ i }} ? 'opacity-100' : 'opacity-0'"
                             {% if i != 0 %}x-cloak{% endif %} aria-hidden="true">
                            {% for image in side %}
                                {% include '_components/image.twig' with { image: image, width: 130, ratio: 1, sizes: '130px', decorative: true, class: 'size-32 flex-none rounded-sm object-cover' } only %}
                            {% endfor %}
                        </div>
                    {% endfor %}
                {% endif %}

                {% if link and link.url %}
                    <a {{ attr(link.attributes|merge({ class: 'group relative flex flex-col items-center gap-2 text-center' })) }}>
                        <{{ tag }} class="text-4xl md:text-6xl lg:text-display">{{ city.heading }}</{{ tag }}>
                        {% if link.label %}
                            <span class="inline-flex items-center gap-2 text-xl text-subtle transition-opacity"
                                  :class="active === {{ i }} ? 'opacity-100' : 'opacity-0 group-focus-visible:opacity-100'">
                                {{ link.label }}
                                <svg class="size-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5"/></svg>
                            </span>
                        {% endif %}
                    </a>
                {% elseif city.heading %}
                    <{{ tag }} class="text-4xl md:text-6xl lg:text-display">{{ city.heading }}</{{ tag }}>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
{% endif %}
