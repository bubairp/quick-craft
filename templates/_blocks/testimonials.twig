{#
 # Testimonials block.
 #   carousel: Figma Home 6-2347 — Swiper row of square tiles (reviews + stats), prev/next
 #   quotes:   Figma Organizers 17-591 — 3 centered quotes with avatar image
 #   reviews:  Figma Invitation Maker 17-2211 — grid of review cards
 # Receives: block, headingLevel
 # Fields: testimonialLayout, spacing, eyebrow, heading, text,
 #         testimonials (testimonial: text=quote, heading, personName, personDetail, image, rating;
 #                       stat: heading=value, text=label, image=background)
 #}
{% set layout = block.testimonialLayout.value ?? 'carousel' %}
{% set items = block.testimonials.eagerly().with(['image', 'logo']).all() %}
{% set level = headingLevel ?? 2 %}
{% set itemTag = 'h' ~ (level + 1) %}

{% if items|length and layout == 'press' %}
{# Press strip (Figma Home 6-1259; reference: partiful.com). Logo buttons in a centred, looping
   Swiper; the active logo moves up and its quote appears. Item: image = logo, personName = outlet,
   text = quote (optional). #}
{# Figma 6-1259: section bg #f7f7f7 (surface), padding 64/32; item 390×219; inactive logo
   240×40 at top 104; active: quote card (white 48%, 390×180, top 34, radius 4, text 20/26
   medium #30302f, 310 wide, content 12px lower) and the logo moves up to top 14. #}
<section data-spacing="{{ block.spacing.value ?? 'default' }}" class="pt-12 pb-6 md:pt-16 md:pb-8" aria-label="{{ block.heading ?: 'In the press'|t }}">
    <div data-carousel="press">
        <div class="swiper select-none">
            {# Rendered 3×: with one set (9 × 390px) a long drag ran past Swiper's spare loop slides
               and showed empty space. Copies are hidden from screen readers and the Tab order. #}
            <ul class="swiper-wrapper">
                {% for pass in 1..3 %}
                {% for item in items %}
                    {% set logo = item.image.one() %}
                    {% set label = item.personName ~ (item.text ? ': “' ~ item.text ~ '”' : '') %}
                    <li class="swiper-slide press-slide w-72! md:w-97.5!" {% if pass > 1 %}aria-hidden="true"{% endif %}>
                        <button type="button" class="press-slide__btn relative block h-55 w-full rounded-sm" aria-label="{{ label }}" {% if pass > 1 %}tabindex="-1"{% endif %}>
                            {% if item.text %}
                                <span class="press-slide__quote absolute inset-x-0 top-8.5 flex h-45 items-center justify-center rounded-sm bg-white/48 px-6 pt-6 text-center text-xl leading-6.5 font-medium tracking-snug text-balance text-ink-soft md:px-10" aria-hidden="true">“{{ item.text }}”</span>
                            {% endif %}
                            <span class="press-slide__logo absolute inset-x-0 top-26 flex justify-center">
                                {% if logo %}
                                    {% include '_components/image.twig' with { image: logo, width: 240, sizes: '240px', decorative: true, class: 'h-10 w-60 object-contain' } only %}
                                {% elseif item.personName %}
                                    <span class="flex h-10 items-center text-xl font-bold">{{ item.personName }}</span>
                                {% endif %}
                            </span>
                        </button>
                    </li>
                {% endfor %}
                {% endfor %}
            </ul>
        </div>
    </div>
</section>

{% elseif items|length and layout == 'quotes' %}
{# Quotes (Figma Organizers 17-576 / 17-591): plain heading; per item a round photo overlapped by a
   tilted club logo, the quote and "name · detail". #}
<section data-spacing="{{ block.spacing.value ?? 'default' }}" class="glow-bg px-4 py-16 md:px-10 md:py-25">
    {% include '_components/section-heading.twig' with {
        eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level, plain: true,
    } only %}
    <ul class="mx-auto mt-12 grid max-w-text gap-10 md:mt-15 md:grid-cols-3 md:gap-4">
        {% for item in items %}
            {% set photo = item.image.one() %}
            {% set logo = (item.logo ?? null) ? item.logo.one() : null %}
            <li>
                <figure class="flex h-full flex-col items-center gap-4 p-2 text-center" data-reveal data-reveal-index="{{ loop.index0 }}">
                    {% if photo or logo %}
                        <div class="flex items-center justify-center" aria-hidden="true">
                            {% if photo %}
                                {% include '_components/image.twig' with { image: photo, width: 115, ratio: 1, sizes: '115px', decorative: true, class: 'relative z-10 size-29 -rotate-10 rounded-full object-cover' } only %}
                            {% endif %}
                            {% if logo %}
                                {% include '_components/image.twig' with { image: logo, width: 115, ratio: 1, sizes: '115px', decorative: true, class: 'size-29 rotate-10 rounded-lg object-cover ' ~ (photo ? '-ml-5') } only %}
                            {% endif %}
                        </div>
                    {% endif %}
                    <div class="flex flex-col gap-0.5">
                        {% if item.text %}
                            <blockquote class="text-balance text-xl font-semibold text-black md:text-2xl">“{{ item.text }}”</blockquote>
                        {% endif %}
                        {% if item.personName or item.personDetail %}
                            <figcaption class="text-lg text-black/60 md:text-xl">{{ [item.personName, item.personDetail]|filter|join(' · ') }}</figcaption>
                        {% endif %}
                    </div>
                </figure>
            </li>
        {% endfor %}
    </ul>
</section>

{% elseif items|length %}
<section data-spacing="{{ block.spacing.value ?? 'default' }}" class="py-16 md:py-24">
    {% include '_components/section-heading.twig' with {
        eyebrow: block.eyebrow, heading: block.heading, text: block.text, level: level,
        align: layout == 'reviews' ? 'left' : 'center',
        class: 'mx-auto max-w-site px-4 md:px-gutter',
    } only %}

    {% if layout == 'carousel' %}
        {# Swiper (src/js/carousels.js): endless loop + auto-advance like the reference.
           Slide widths come from the classes on each slide. The set is rendered 3× (as the
           reference does) because Swiper's loop needs more slides than fit on a wide screen;
           the copies are hidden from screen readers. #}
        {# 4 sets: with 3, a long mouse drag outran Swiper's spare slides and showed empty space #}
        {% set passes = items|length > 1 ? 4 : 1 %}
        <div class="mt-12 md:mt-16" data-carousel="loop">
            <div class="swiper select-none" aria-label="{{ block.heading ?: 'Testimonials'|t }}">
              <ul class="swiper-wrapper">
                {% for pass in 1..passes %}
                {% for item in items %}
                    {% set image = item.image.one() %}
                    <li class="swiper-slide relative flex! aspect-square w-72! overflow-hidden rounded-md md:w-85! {{ item.type.handle == 'stat' and not image ? 'bg-ink' : 'bg-surface' }}" {% if pass > 1 %}aria-hidden="true"{% endif %}>
                        {% if image %}
                            {% include '_components/image.twig' with { image: image, width: 340, ratio: 1, sizes: '340px', decorative: pass > 1, class: 'absolute inset-0 size-full object-cover' } only %}
                        {% endif %}

                        {% if item.type.handle == 'stat' %}
                            <div class="relative flex size-full flex-col p-6 uppercase text-white {{ image ? 'justify-between' : 'items-center justify-center gap-6 text-center' }}">
                                {% if item.heading %}<p class="{{ image ? 'text-6xl md:text-7xl' : 'text-xl' }}">{{ item.heading }}</p>{% endif %}
                                {% if item.text %}<p class="{{ image ? 'text-2xl' : 'text-xl' }}">{{ item.text }}</p>{% endif %}
                            </div>
                        {% else %}
                            <figure class="relative m-auto w-full p-5">
                                <div class="rounded-md bg-white/80 p-4 shadow-soft backdrop-blur-md">
                                    {% if item.heading %}<{{ itemTag }} class="text-sm font-bold">{{ item.heading }}</{{ itemTag }}>{% endif %}
                                    <figcaption class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted">
                                        {% include '_components/stars.twig' with { rating: item.rating, class: 'size-3 text-star' } only %}
                                        {% if item.personDetail %}<span>{{ item.personDetail }}</span>{% endif %}
                                        {% if item.personName %}<span>{{ item.personName }}</span>{% endif %}
                                    </figcaption>
                                    {% if item.text %}
                                        <blockquote class="mt-2 text-xs text-night">{{ item.text|nl2br }}</blockquote>
                                    {% endif %}
                                </div>
                            </figure>
                        {% endif %}
                    </li>
                {% endfor %}
                {% endfor %}
              </ul>
            </div>

            {% if items|length > 1 %}
                <div class="mt-6 flex justify-center gap-2">
                    <button type="button" data-carousel-prev class="flex size-11 items-center justify-center rounded-full bg-line text-ink transition-opacity hover:bg-surface">
                        <span class="sr-only">{{ 'Previous'|t }}</span>
                        {% include '_components/icon.twig' with { name: 'chevron-left', class: 'size-5' } only %}
                    </button>
                    <button type="button" data-carousel-next class="flex size-11 items-center justify-center rounded-full bg-line text-ink transition-opacity hover:bg-surface">
                        <span class="sr-only">{{ 'Next'|t }}</span>
                        {% include '_components/icon.twig' with { name: 'chevron-right', class: 'size-5' } only %}
                    </button>
                </div>
            {% endif %}
        </div>

    {% else %}
        <ul class="mx-auto mt-12 grid max-w-content gap-6 px-4 md:px-gutter {{ layout == 'quotes' ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-3' }}">
            {% for item in items %}
                {% set image = item.image.one() %}
                <li>
                    <figure class="flex h-full flex-col gap-4 {{ layout == 'quotes' ? 'items-center text-center' : 'rounded-md border border-line bg-white p-5 shadow-card' }}">
                        {% if layout == 'quotes' and image %}
                            {% include '_components/image.twig' with { image: image, width: 140, ratio: 1, sizes: '140px', class: 'size-28 rounded-full object-cover' } only %}
                        {% endif %}
                        {% if layout == 'reviews' %}
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    {% if item.heading %}<{{ itemTag }} class="text-sm font-bold">{{ item.heading }}</{{ itemTag }}>{% endif %}
                                    {% include '_components/stars.twig' with { rating: item.rating, class: 'size-3 text-star' } only %}
                                </div>
                                {% if item.personDetail %}<span class="text-xs text-muted">{{ item.personDetail }}</span>{% endif %}
                            </div>
                        {% endif %}
                        {% if item.text %}
                            <blockquote class="{{ layout == 'quotes' ? 'text-xl md:text-2xl' : 'text-sm' }}">
                                {% if layout == 'quotes' %}“{{ item.text }}”{% else %}{{ item.text|nl2br }}{% endif %}
                            </blockquote>
                        {% endif %}
                        {% if item.personName or (layout == 'quotes' and item.personDetail) %}
                            <figcaption class="text-sm text-muted">
                                {{ item.personName }}{% if layout == 'quotes' and item.personDetail %} · {{ item.personDetail }}{% endif %}
                            </figcaption>
                        {% endif %}
                    </figure>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
{% endif %}
