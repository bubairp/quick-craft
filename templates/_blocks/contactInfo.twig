{#
 # Contact details block. Figma: Contact 76:166 (+ the contact form, which Figma doesn't show);
 # redesigned 2026-11-20 (CLAUDE.md › contactInfo block).
 # From lg: left (5/12) = heading + text, the contact details as link cards, the socials as
 # chips; right (7/12, sticky) = the Wheel Form in a white card. Phones: the same order, stacked.
 # The lists always come from Site settings (via _globals), never from the block.
 # Receives: block, headingLevel, wheelformErrors, values (from the page, for the form's error state)
 # Fields: heading, text, contactHeading, socialHeading, formHeading, contactForm, spacing
 #}
{% set siteSettings = _globals.get('siteSettings') %}
{% set details = siteSettings ? siteSettings.contactDetails.all()|filter(d => d.detail|trim|length) : [] %}
{% set socials = siteSettings ? siteSettings.socialLinks.all()|filter(s => s.externalLink.url ?? false) : [] %}
{% set form = block.contactForm ?? null %}
{% set level = headingLevel ?? 2 %}
{% set tag = 'h' ~ level %}
{% set subTag = 'h' ~ (block.heading ? level + 1 : level) %}
{% set platformNames = { instagram: 'Instagram', x: 'X (Twitter)', tiktok: 'TikTok', linkedin: 'LinkedIn', facebook: 'Facebook', youtube: 'YouTube', threads: 'Threads', pinterest: 'Pinterest', substack: 'Substack' } %}
{% set platformIcons = { instagram: 'brand-instagram', x: 'brand-x', tiktok: 'brand-tiktok', linkedin: 'brand-linkedin', facebook: 'brand-facebook', youtube: 'brand-youtube', threads: 'brand-threads', pinterest: 'brand-pinterest', substack: 'news', other: 'link' } %}
{% set detailIcons = { email: 'mail', phone: 'phone', whatsapp: 'brand-whatsapp', address: 'map-pin' } %}
{# shared card look: white, inset ring; links lift a little and their shadow grows on hover #}
{% set card = 'rounded-lg bg-white ring-1 ring-inset ring-black/5 shadow-subtle' %}
{% set cardLink = card ~ ' group transition-[translate,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink' %}
{% set iconTile = 'grid shrink-0 place-items-center rounded-md bg-surface text-ink' %}

{% if block.heading or details|length or socials|length or form %}
<section data-spacing="{{ block.spacing.value ?? 'default' }}" class="px-4 py-12 md:px-gutter md:py-20">
    <div class="mx-auto grid max-w-content gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">

        {# ── Left: heading, contact cards, social chips ── #}
        <div class="flex flex-col gap-10 lg:col-span-5">
            {% if block.heading or block.text %}
                <div class="flex flex-col gap-3">
                    {% if block.heading %}<{{ tag }} class="text-4xl font-bold md:text-6xl">{{ block.heading }}</{{ tag }}>{% endif %}
                    {% if block.text %}<p class="text-xl text-black/60 md:text-2xl">{{ block.text }}</p>{% endif %}
                </div>
            {% endif %}

            {% if details|length %}
                <div class="flex flex-col gap-4">
                    {% if block.contactHeading %}<{{ subTag }} class="text-xl font-bold">{{ block.contactHeading }}</{{ subTag }}>{% endif %}
                    <ul class="flex flex-col gap-3">
                        {% for item in details %}
                            {% set type = item.contactType.value ?? 'email' %}
                            {% set value = item.detail|trim %}
                            {% set digits = value|replace('/[^0-9+]/', '') %}
                            {% set href = { email: 'mailto:' ~ value, phone: 'tel:' ~ digits, whatsapp: 'https://wa.me/' ~ digits|replace({ '+': '' }) }[type] ?? null %}
                            {% set label = item.label ?: item.contactType.label %}
                            {% set inner %}
                                <span class="{{ iconTile }} size-11">{% include '_components/icon.twig' with { name: detailIcons[type] ?? 'info-circle', class: 'size-5' } only %}</span>
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="text-lg font-bold">{{ label }}</span>
                                    <span class="text-base break-words text-black/60">{{ href ? value : value|nl2br }}</span>
                                </span>
                            {% endset %}
                            <li>
                                {% if href %}
                                    <a href="{{ href }}" class="{{ cardLink }} flex items-center gap-4 p-4" {% if type == 'whatsapp' %}target="_blank" rel="noopener"{% endif %}>
                                        {{ inner }}
                                        {% include '_components/icon.twig' with { name: 'arrow-up-right', class: 'size-5 shrink-0 text-black/30 transition-[translate,color] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ink' } only %}
                                    </a>
                                {% else %}
                                    <address class="{{ card }} flex items-center gap-4 p-4 not-italic">{{ inner }}</address>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if socials|length %}
                <div class="flex flex-col gap-4">
                    {% if block.socialHeading %}<{{ subTag }} class="text-xl font-bold">{{ block.socialHeading }}</{{ subTag }}>{% endif %}
                    <ul class="grid grid-cols-2 gap-3">
                        {% for item in socials %}
                            {% set platform = item.platform.value ?? 'other' %}
                            {% set name = platformNames[platform] ?? item.platform.label %}
                            {% set shown = (item.handle ?? '')|trim ?: item.externalLink.url|replace('/^https?:\\/\\/(www\\.)?/', '') %}
                            <li>
                                <a {{ attr(item.externalLink.attributes|merge({ class: cardLink ~ ' flex h-full items-center gap-3 p-3', 'aria-label': name ~ ': ' ~ shown })) }}>
                                    <span class="{{ iconTile }} size-10 transition-colors duration-300 group-hover:bg-ink group-hover:text-paper">{% include '_components/icon.twig' with { name: platformIcons[platform] ?? 'link', class: 'size-5' } only %}</span>
                                    <span class="flex min-w-0 flex-col">
                                        <span class="text-base font-semibold">{{ name }}</span>
                                        <span class="line-clamp-2 text-sm break-words text-black/60">{{ shown }}</span>
                                    </span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}
        </div>

        {# ── Right: the form card ── #}
        {% if form or (currentUser and currentUser.admin) %}
            {# sticky from lg: the left column is the taller one, so the form stays in view beside it #}
            <div id="contact-form" class="scroll-mt-28 rounded-2xl bg-white p-6 shadow-card ring-1 ring-inset ring-black/5 md:p-10 lg:sticky lg:top-32 lg:col-span-7">
                {% if block.formHeading %}<{{ subTag }} class="mb-6 text-3xl font-bold md:mb-8">{{ block.formHeading }}</{{ subTag }}>{% endif %}
                {% include '_components/wheel-form.twig' with {
                    form: form, anchor: 'contact-form', columns: 2,
                    errors: wheelformErrors ?? {}, values: values ?? {},
                } only %}
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
