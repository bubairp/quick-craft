{#
 # Image helper macros, used exactly as in Site7 Engine (themes/site7-theme/templates/_macros/images.twig).
 # CLAUDE.md › Content & data › Images.
 #
 #   {% import "_macros/images" as images %}
 #   {{ images.singleImg(block.image.one(), 640, { ratio: 1.5 }, 'w-full rounded-lg') }}
 #   {{ images.singleImg(logo, 160, {}, 'h-6 w-auto', { alt: item.title }) }}
 #
 # Imports don't carry into included templates: every template that shows images imports it.
 #}

{# =========================================================
  SINGLE IMAGE
  singleImg(image, size, options, classes, attr): a responsive image/video from a Craft asset.
  Prints nothing for an empty asset (no placeholder).

  image    Asset|null  the asset
  size     int         largest rendered width in CSS px (default 800)
  options  hash        Site7's keys:
                         ratio           width/height crop ratio (e.g. 1, 16/9); none keeps the original ratio
                         lazy            default true; false = above the fold (fetchpriority=high)
                         quality         transform quality 1–100 (also `jpegQuality`); none = Craft's default
                         pictureClasses  classes on the <picture> (only when there is one)
                       ours:
                         sizes           sizes attribute (default '100vw'); lazy images get "auto, " in front
                         decorative      true = alt=""
                         sources         art direction: [{ media: '(max-width: 1023px)', ratio: 3/2, width: 1024, sizes: '100vw' }]
                                         → <picture> with one <source> per entry (first match wins)
  classes  string      classes on the <img>/<video>
  attr     hash        extra <img> attributes; an `alt` here overrides the asset's alt

  WebP via Craft native transforms; srcset with width descriptors; never wider than the original.
  SVG and GIF: the original file (no transform, srcset or crop; ratio and sources are ignored).
========================================================= #}
{% macro singleImg(image, size = 800, options = {}, classes = '', attr = {}) %}
    {%- if image -%}
        {%- set width = size ?: 800 -%}
        {%- set ratio = options.ratio ?? null -%}
        {%- set sizes = options.sizes ?? '100vw' -%}
        {%- set eager = not (options.lazy ?? true) -%}
        {%- set quality = options.quality ?? options.jpegQuality ?? null -%}
        {%- set sources = options.sources ?? [] -%}
        {%- set alt = attr.alt ?? ((options.decorative ?? false) ? '' : (image.alt ?? '')) -%}
        {%- set extra = attr|filter((v, k) => k != 'alt') -%}
        {%- set loading = eager ? 'fetchpriority="high"' : 'loading="lazy" decoding="async"' -%}

        {%- if image.kind == 'video' -%}
            <video src="{{ image.url }}" class="{{ classes }}" autoplay muted loop playsinline preload="metadata"
                   {% if alt %}aria-label="{{ alt }}"{% else %}aria-hidden="true"{% endif %}></video>

        {%- elseif image.kind == 'image' and image.extension|lower in ['svg', 'gif'] -%}
            {# the original file: a transform would rasterise an SVG (white background) and drop a GIF's animation #}
            <img src="{{ image.url }}"
                 {% if image.width %}width="{{ image.width }}" height="{{ image.height }}"{% endif %}
                 alt="{{ alt }}" {{ loading|raw }} class="{{ classes }}" {{ attr(extra) }}>

        {%- elseif image.kind == 'image' -%}
            {# the <source>s first (art direction), the <img> (main crop) last #}
            {%- set sets = sources|map(s => s|merge({ img: false }))|merge([{ width: width, ratio: ratio, sizes: sizes, img: true }]) -%}
            {% if sources|length %}<picture class="{{ options.pictureClasses ?? 'contents' }}">{% endif %}
            {% for set in sets %}
                {#
                 # Largest file: 2× the rendered width for high-DPI screens, never wider than the
                 # original (Craft would upscale), and for a crop never wider than the original's
                 # height allows. Width descriptors (…w) so the browser uses `sizes`; steps under
                 # 160px are skipped.
                 #}
                {%- set setRatio = set.ratio ?? null -%}
                {%- set setWidth = set.width ?? width -%}
                {%- set maxWidth = image.width ? min(setWidth * 2, image.width) : setWidth * 2 -%}
                {%- if setRatio and image.height %}{% set maxWidth = min(maxWidth, (image.height * setRatio)|round) %}{% endif -%}
                {%- set transform = (setRatio
                    ? { width: maxWidth, height: (maxWidth / setRatio)|round, mode: 'crop', format: 'webp' }
                    : { width: maxWidth, mode: 'fit', format: 'webp' })|merge(quality ? { quality: quality } : {}) -%}
                {%- set srcWidths = [0.25, 0.5, 0.75, 1]|map(f => (maxWidth * f)|round)|filter(w => w >= 160 or w == maxWidth)|map(w => w ~ 'w') -%}
                {%- set srcset = image.getSrcset(srcWidths|values, transform) -%}
                {# lazy: "auto" lets supporting browsers use the rendered width (from Site7's helper) #}
                {%- set sizesAttr = (eager ? '' : 'auto, ') ~ (set.sizes ?? sizes) -%}
                {%- if not set.img -%}
                    {% if srcset %}
                        <source media="{{ set.media }}" type="image/webp" srcset="{{ srcset }}" sizes="{{ sizesAttr }}"
                                width="{{ image.getWidth(transform) }}" height="{{ image.getHeight(transform) }}">
                    {% endif %}
                {%- else -%}
                    {%- set src = image.getUrl(transform) -%}
                    {% if src %}
                        <img src="{{ src }}"
                             {% if srcset %}srcset="{{ srcset }}" sizes="{{ sizesAttr }}"{% endif %}
                             width="{{ image.getWidth(transform) }}" height="{{ image.getHeight(transform) }}"
                             alt="{{ alt }}" {{ loading|raw }} class="{{ classes }}" {{ attr(extra) }}>
                    {% endif %}
                {%- endif -%}
            {% endfor %}
            {% if sources|length %}</picture>{% endif %}
        {%- endif -%}
    {%- endif -%}
{% endmacro %}
