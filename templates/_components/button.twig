{#
 # Button rendered from a Craft Link field value (LinkData).
 # Renders nothing when the link is empty.
 #
 # Props:
 #   link     LinkData|null   required
 #   variant  'dark' | 'darkOnDark' | 'light' | 'outlineLight'   (default 'dark')
 #   shape    'pill' | 'rounded'                   (default 'pill')
 #   size     'md' | 'sm'   (default 'md'; 'sm' = 44px tall, e.g. next to the mobile menu button)
 #   class    extra classes (layout/margins only; padding and font size come from size,
 #            because a padding class passed here would not reliably override them)
 # Hover (reference site): lifts 2px, scales to 1.01, soft shadow. Off for reduced motion.
 #}
{% set link = link ?? null %}
{% if link and link.url %}
    {% set variants = {
        dark: 'bg-ink text-paper border-night hover:bg-night',
        darkOnDark: 'bg-ink text-paper border-graphite hover:bg-night',
        light: 'bg-paper text-black border-line hover:bg-surface',
        outlineLight: 'bg-transparent text-paper border-paper/30 hover:bg-paper/10',
    } %}
    {% set sizes = {
        md: 'px-6 py-4 text-base',
        sm: 'h-11 px-4 text-sm',
    } %}
    {% set classes = [
        'inline-flex items-center justify-center gap-2 whitespace-nowrap border font-semibold leading-tight tracking-normal',
        sizes[size ?? 'md'] ?? sizes.md,
        'transition duration-200 ease-out hover:-translate-y-0.5 hover:scale-101 hover:shadow-lift motion-reduce:translate-none motion-reduce:scale-none',
        (shape ?? 'pill') == 'pill' ? 'rounded-full' : 'rounded-sm',
        variants[variant ?? 'dark'] ?? variants.dark,
        class ?? '',
    ]|join(' ') %}
    <a {{ attr(link.attributes|merge({ class: classes })) }}>{{ link.label ?: link.url }}</a>
{% endif %}
