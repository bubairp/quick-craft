{#
 # Feature card: media panel, emoji, heading, text, text link.
 # Props:
 #   card     Entry (type 'card')
 #   variant  'feature' (default, Home 6-1320: centered, big title)
 #            'compact' (Home 6-1719: square tile, inline caption + link)
 #            'text'    (Careers 6-6770: white card, emoji + title + text, no image)
 #   level    heading level (3)
 #   dark     bool
 #   soft     bool: the section uses the "soft" (grey) scheme, so the empty media panel is white
 #   sizes    sizes attribute for the image
 #   revealIndex  position in its grid, for the staggered reveal-on-scroll (0, 1, 2 …)
 #}
{% set dark = dark ?? false %}
{% set tag = 'h' ~ (level ?? 3) %}
{% set link = card.primaryButton ?? null %}

{% if (variant ?? 'feature') == 'text' %}
{# 'text' (Careers 6-6770): white card, emoji + title + text, no image #}
<article class="flex h-full flex-col gap-1 rounded-lg p-7.5 {{ dark ? 'bg-white/10 text-white' : 'bg-white shadow-card' }}" data-reveal data-reveal-index="{{ revealIndex ?? 0 }}">
    {% if card.emoji %}<span class="text-headline" aria-hidden="true">{{ card.emoji }}</span>{% endif %}
    {% if card.heading %}
        <{{ tag }} class="text-2xl font-semibold">{{ card.heading }}</{{ tag }}>
    {% endif %}
    {% if card.text %}
        <p class="text-base {{ dark ? 'text-line' : 'text-black/60' }}">{{ card.text|nl2br }}</p>
    {% endif %}
    {% if link and link.url %}
        <a {{ attr(link.attributes|merge({ class: 'mt-2 self-start text-base font-medium underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current' })) }}>{{ link.label ?: link.url }}</a>
    {% endif %}
</article>
{% else %}
{% set compact = (variant ?? 'feature') == 'compact' %}
{% set image = card.image.one() ?? null %}
{% set aspect = compact ? 'aspect-tile' : 'aspect-card' %}

<article class="group flex flex-col {{ compact ? 'gap-4' : 'gap-6 md:gap-8' }}" data-reveal data-reveal-index="{{ revealIndex ?? 0 }}">
    <div class="overflow-hidden rounded-md {{ dark ? 'bg-night' : (compact ? 'bg-line' : ((soft ?? false) ? 'bg-white' : 'bg-surface')) }}">
        {% if image %}
            {% include '_components/image.twig' with {
                image: image, width: compact ? 360 : 480, ratio: compact ? 347 / 339 : 472 / 502,
                sizes: sizes ?? (compact ? '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'),
                class: aspect ~ ' h-auto w-full object-cover',
            } only %}
        {% else %}
            <div class="{{ aspect }} w-full" aria-hidden="true"></div>
        {% endif %}
    </div>

    {% if compact %}
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-lg font-light md:text-xl">
            {% if card.heading %}
                <{{ tag }} class="{{ dark ? 'text-line' : 'text-subtle' }}">{{ card.heading }}</{{ tag }}>
            {% endif %}
            {% if link and link.url %}
                <a {{ attr(link.attributes|merge({ class: (dark ? 'text-white' : 'text-ink') ~ ' underline underline-offset-4 hover:no-underline' })) }}>{{ link.label ?: link.url }}</a>
            {% endif %}
        </div>
    {% else %}
        <div class="flex flex-col items-center gap-2 text-center">
            {% if card.emoji %}<span class="text-3xl" aria-hidden="true">{{ card.emoji }}</span>{% endif %}
            {% if card.heading %}
                <{{ tag }} class="text-balance text-2xl font-bold md:text-3xl">{{ card.heading }}</{{ tag }}>
            {% endif %}
            {% if card.text %}
                <p class="text-balance text-lg font-light md:text-xl {{ dark ? 'text-line' : 'text-subtle' }}">{{ card.text|nl2br }}</p>
            {% endif %}
            {% if link and link.url %}
                <a {{ attr(link.attributes|merge({ class: 'text-lg font-medium underline underline-offset-4 hover:no-underline' })) }}>{{ link.label ?: link.url }}</a>
            {% endif %}
        </div>
    {% endif %}
</article>
{% endif %}
