{# Star rating (Tabler "star" filled icon). Props: rating (number 0-5), class (size/colour classes for each star) #}
{% set rating = rating ?? 0 %}
{% if rating > 0 %}
    <span class="inline-flex gap-0.5" role="img" aria-label="{{ 'Rated {n} out of 5'|t(params={ n: rating }) }}">
        {% for i in 1..5 %}
            {% include '_components/icon.twig' with { name: 'star', filled: true, class: (class ?? 'size-3') ~ (i <= rating|round ? '' : ' opacity-30') } only %}
        {% endfor %}
    </span>
{% endif %}
