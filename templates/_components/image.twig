{#
 # Responsive image/video from a Craft asset. Renders nothing for an empty asset.
 #
 # Props:
 #   image     Asset|null   required
 #   width     int          largest rendered width in CSS px (default 800)
 #   ratio     float|null   width/height crop ratio (e.g. 1, 16/9); null keeps the original ratio
 #   sizes     string       sizes attribute (default '100vw')
 #   eager     bool         above the fold: no lazy loading, fetchpriority=high
 #   class     string       classes for the <img>/<video>
 #   decorative bool        force alt=""
 #}
{% set image = image ?? null %}
{% if image %}
    {% set width = width ?? 800 %}
    {% set ratio = ratio ?? null %}
    {% set class = class ?? '' %}

    {% if image.kind == 'video' %}
        <video src="{{ image.url }}" class="{{ class }}" autoplay muted loop playsinline preload="metadata"
               {% if image.alt %}aria-label="{{ image.alt }}"{% else %}aria-hidden="true"{% endif %}></video>
    {% elseif image.kind == 'image' %}
        {# Largest file: 2× the rendered width for sharp high-DPI screens, but never wider than the
           original (Craft would upscale it). #}
        {% set maxWidth = image.width ? min(width * 2, image.width) : width * 2 %}
        {% if ratio and image.height %}{% set maxWidth = min(maxWidth, (image.height * ratio)|round) %}{% endif %}
        {% set transform = ratio
            ? { width: maxWidth, height: (maxWidth / ratio)|round, mode: 'crop', format: 'webp' }
            : { width: maxWidth, mode: 'fit', format: 'webp' } %}
        {# SVGs are served as-is: transforming them rasterises to WebP with a white background #}
        {% set isSvg = image.extension|lower == 'svg' %}
        {# Width descriptors (…w), so the browser can use `sizes` to pick a file; density descriptors
           (0.5x) would make it ignore `sizes`. Steps under 160px are skipped. #}
        {% set srcWidths = [0.25, 0.5, 0.75, 1]|map(f => (maxWidth * f)|round)|filter(w => w >= 160 or w == maxWidth)|map(w => w ~ 'w') %}
        {% set srcset = isSvg ? false : image.getSrcset(srcWidths|values, transform) %}
        <img src="{{ isSvg ? image.url : image.getUrl(transform) }}"
             {% if srcset %}srcset="{{ srcset }}" sizes="{{ sizes ?? '100vw' }}"{% endif %}
             width="{{ image.getWidth(transform) }}"
             height="{{ image.getHeight(transform) }}"
             alt="{{ (decorative ?? false) ? '' : (image.alt ?? '') }}"
             {% if eager ?? false %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
             class="{{ class }}">
    {% endif %}
{% endif %}
