# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Database + site URL: provided by DDEV, nothing to set here.
# `.ddev/config.yaml` (type: craftcms) injects these into the web container:
#   CRAFT_DB_DRIVER=mysql  CRAFT_DB_SERVER=db  CRAFT_DB_PORT=3306  CRAFT_DB_DATABASE=db
#   CRAFT_DB_USER / CRAFT_DB_PASSWORD (DDEV defaults)  PRIMARY_SITE_URL=https://quick-craft.ddev.site
# Inspect the database: https://quick-craft.ddev.site:8037 (phpMyAdmin) or `ddev mysql`.
# Without DDEV, set them here, as in .env.example.staging.
